
@{
    var currentPath = Context.Request.Path;
    var isDashboard = currentPath =="/";
    var isTransaction = currentPath.StartsWithSegments("/Transaction");
    var isSetting = currentPath.StartsWithSegments("/Setting");
    var isAccount = currentPath.StartsWithSegments("/Account");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - My Finance</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/LearnMVC.styles.css"
          asp-append-version="true" />
</head>

<body class="bg-white text-dark min-vh-100">

    <div class="d-flex min-vh-100">

        <!-- Sidebar dùng chung -->
        <nav class="bg-light p-3 border-end d-flex flex-column"
             style="width: 260px; flex-shrink: 0;">

            <a href="/"
               class="d-flex align-items-center mb-3 text-dark text-decoration-none px-2">

                <i class="bi bi-wallet2 fs-4 me-2 text-primary"></i>
                <span class="fs-5 fw-bold">My Finance</span>
            </a>

            <hr class="mt-0 mb-3 text-secondary opacity-25" />

            <ul class="nav flex-column gap-1">

                <li class="nav-item">
                    <a href="/"
                       class="nav-link rounded-2 @(isDashboard ? "bg-primary-subtle text-primary fw-semibold" : "text-secondary")">   
                        <i class="bi bi-grid me-2"></i>
                        Tổng quan
                    </a>
                </li>

                <li class="nav-item">
                    <a href="/Transaction/TransactionPage" class="nav-link rounded-2 @(isTransaction ? "bg-primary-subtle text-primary fw-semibold" : "text-secondary")">
                        <i class="bi bi-journal-bookmark me-2"></i>
                        Giao dịch
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link rounded-2 @(isSetting ? "bg-primary-subtle text-primary fw-semibold" : "text-secondary")">
                        <i class="bi bi-gear me-2"></i>
                        Cài đặt
                    </a>
                </li>
                <li class = "nav-item">
                    <a href ="/Account/AccountPage" class ="nav-link rounded-2 @(isAccount ? "bg-primary-subtle text-primary fw-semibold" : "text-secondary")">
                        <i class="bi bi-person-circle me-2"></i>
                        Tài Khoản
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Nội dung thay đổi theo từng trang -->
        <main class="flex-grow-1 p-4">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
